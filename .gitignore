# Dépendances
node_modules/

# Variables d'environnement (contiennent des secrets !)
.env
.env.local

# Credentials OAuth Google Drive (migration Cloudinary → Drive) + tokens générés
thebridgeflow-back/credentials-drive*.json
thebridgeflow-back/token-drive*.json

# Backups locaux de la collection Formation (migration Drive) — restauration
# manuelle uniquement, pas destinés à être versionnés
thebridgeflow-back/scripts/drive/backups/

# Build frontend
thebridgeflow-front/dist/

# Fichiers uploadés par les utilisateurs
thebridgeflow-back/uploads/*
!thebridgeflow-back/uploads/.gitkeep

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
thebridgeflow-front/public/videos-*/
thebridgeflow-front/public/*.mp4
