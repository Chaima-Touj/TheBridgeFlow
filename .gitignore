# Dépendances
node_modules/

# Variables d'environnement (contiennent des secrets !)
.env
.env.local

# Credentials OAuth Google Drive (migration Cloudinary → Drive) + tokens générés
server/credentials-drive*.json
server/token-drive*.json

# Backups locaux de la collection Formation (migration Drive) — restauration
# manuelle uniquement, pas destinés à être versionnés
server/scripts/drive/backups/

# Build frontend
client/dist/

# Fichiers uploadés par les utilisateurs
server/uploads/*
!server/uploads/.gitkeep

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
client/public/videos-*/
client/public/*.mp4
