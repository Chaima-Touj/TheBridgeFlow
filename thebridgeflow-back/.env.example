# Create a v3 key pair in Google reCAPTCHA Admin Console. Keep the secret only in the backend environment.
# Sans RECAPTCHA_SECRET_KEY, la verification anti-robot est desactivee (y compris en production).
RECAPTCHA_SECRET_KEY=<google_recaptcha_v3_secret_key>
RECAPTCHA_MINIMUM_SCORE=0.5
# Comma-separated frontend hostnames configured for this key.
RECAPTCHA_ALLOWED_HOSTNAMES=9antra.tn,the-bridge-flow.onrender.com,the-bridge-flow-app.onrender.com,stage-flow-app.onrender.com,localhost,127.0.0.1
MONGO_URI=<votre_uri_mongodb_atlas>
JWT_SECRET=<votre_secret_jwt>
JWT_EXPIRES_IN=<duree_expiration_token_ex_7d>
PORT=<port_du_serveur_ex_5000>
CLIENT_URL=<url_du_frontend_ex_http://localhost:5173>
GEMINI_API_KEY=<votre_cle_api_gemini>
# Nom du modele Gemini a utiliser, ex: gemini-2.5-flash-lite, gemini-3.1-flash-lite
# -- depend du plan souscrit. Absent = fallback gemini-2.5-flash-lite (voir
# gemini.service.js), a renseigner des que le plan est choisi.
GEMINI_MODEL=<nom_du_modele_gemini_ex_gemini-2.5-flash-lite>
SMTP_USER=chimatouj@gmail.com
SMTP_PASS=<votre_mot_de_passe_application_gmail>
EMAIL_FROM=<adresse_email_expediteur>
GOOGLE_CLIENT_ID=<votre_client_id_google_oauth>
FACEBOOK_APP_ID=<votre_app_id_facebook>
FACEBOOK_APP_SECRET=<votre_app_secret_facebook>
