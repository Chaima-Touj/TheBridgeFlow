@startuml use_case_global
skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName "Times New Roman"

' Basé exclusivement sur thebridgeflow-back/routes/*.js et thebridgeflow-back/middleware/auth.middleware.js
' (protect = authentification requise, authorize("admin") = rôle admin requis).
' Rôles réels du modèle User (thebridgeflow-back/models/users.model.js:36) : "étudiant", "admin"
' uniquement -- pas de rôle Entreprise/Encadrant (supprimés, voir git log
' 2026-07-22 "refactor(roles)").

left to right direction

actor "Visiteur" as Visiteur
actor "Étudiant" as Etudiant
actor "Administrateur" as Admin
actor "Assistant IA (SAGE)" as SAGE <<external>>

Etudiant --|> Visiteur

rectangle "TheBridgeFlow" {

  ' ── Authentification (thebridgeflow-back/routes/auth.routes.js) ─────────────────────
  usecase "S'authentifier" as UC_Auth
  usecase "S'inscrire (register)" as UC_Register
  usecase "Se connecter (email/Google/Facebook)" as UC_Login
  usecase "Vérifier son email (code)" as UC_VerifyEmail
  usecase "Réinitialiser son mot de passe" as UC_ResetPwd

  ' ── Consultation publique ─────────────────────────────────────────────
  usecase "Consulter les offres" as UC_ViewOffers
  usecase "Consulter les formations" as UC_ViewFormations
  usecase "Consulter les actualités" as UC_ViewNews

  ' ── Étudiant (thebridgeflow-back/routes/applications.routes.js, interviews.routes.js,
  '    enrollmentRequest.routes.js, enrollment.routes.js, favorites.routes.js,
  '    conversations.routes.js, notifications.routes.js, ai.routes.js) ────
  usecase "Gérer son profil" as UC_Profile
  usecase "Postuler à une offre" as UC_Apply
  usecase "Suivre ses candidatures" as UC_TrackApplications
  usecase "Confirmer / annuler un entretien" as UC_RespondInterview
  usecase "Demander une inscription à une formation" as UC_RequestEnroll
  usecase "Suivre sa progression de formation" as UC_TrackProgress
  usecase "Gérer ses favoris" as UC_Favorites
  usecase "Échanger des messages" as UC_Messaging
  usecase "Consulter ses notifications" as UC_Notifications
  usecase "Utiliser l'assistant IA" as UC_UseAI

  ' ── Administrateur (thebridgeflow-back/routes/admin.routes.js, offers.routes.js,
  '    applications.routes.js, interviews.routes.js, formation.routes.js,
  '    enrollmentRequest.routes.js, enrollment.routes.js, news.routes.js,
  '    settings.routes.js) ────────────────────────────────────────────────
  usecase "Gérer les offres de stage" as UC_ManageOffers
  usecase "Traiter les candidatures" as UC_ManageApplications
  usecase "Proposer un entretien" as UC_ProposeInterview
  usecase "Gérer les formations (contenu, vidéos)" as UC_ManageFormations
  usecase "Traiter les demandes d'inscription" as UC_ManageEnrollRequests
  usecase "Gérer les inscriptions actives" as UC_ManageEnrollments
  usecase "Gérer les utilisateurs" as UC_ManageUsers
  usecase "Gérer les actualités" as UC_ManageNews
  usecase "Consulter les statistiques" as UC_ViewStats
  usecase "Configurer les paramètres du site" as UC_ManageSettings
}

' ── Visiteur ──────────────────────────────────────────────────────────────
Visiteur --> UC_ViewOffers
Visiteur --> UC_ViewFormations
Visiteur --> UC_ViewNews
Visiteur --> UC_Register
Visiteur --> UC_Login
Visiteur --> UC_ResetPwd
UC_Register ..> UC_VerifyEmail : <<include>>

' ── Étudiant ──────────────────────────────────────────────────────────────
Etudiant --> UC_Profile
Etudiant --> UC_Apply
Etudiant --> UC_TrackApplications
Etudiant --> UC_RespondInterview
Etudiant --> UC_RequestEnroll
Etudiant --> UC_TrackProgress
Etudiant --> UC_Favorites
Etudiant --> UC_Messaging
Etudiant --> UC_Notifications
Etudiant --> UC_UseAI

' ── Administrateur ───────────────────────────────────────────────────────
Admin --> UC_ManageOffers
Admin --> UC_ManageApplications
Admin --> UC_ProposeInterview
Admin --> UC_ManageFormations
Admin --> UC_ManageEnrollRequests
Admin --> UC_ManageEnrollments
Admin --> UC_ManageUsers
Admin --> UC_ManageNews
Admin --> UC_ViewStats
Admin --> UC_ManageSettings
' route ai.routes.js n'a pas de restriction authorize("admin") : accessible
' aux deux rôles authentifiés (protect uniquement, thebridgeflow-back/routes/ai.routes.js)
Admin --> UC_UseAI

' ── Acteur externe SAGE (Groq LLM, thebridgeflow-back/services/groq.service.js) ──────
SAGE --> UC_UseAI

' ── Tous les use cases protégés (protect middleware) incluent l'authentification ──
UC_Profile          ..> UC_Auth : <<include>>
UC_Apply             ..> UC_Auth : <<include>>
UC_TrackApplications ..> UC_Auth : <<include>>
UC_RespondInterview  ..> UC_Auth : <<include>>
UC_RequestEnroll     ..> UC_Auth : <<include>>
UC_TrackProgress     ..> UC_Auth : <<include>>
UC_Favorites         ..> UC_Auth : <<include>>
UC_Messaging         ..> UC_Auth : <<include>>
UC_Notifications     ..> UC_Auth : <<include>>
UC_UseAI             ..> UC_Auth : <<include>>

UC_ManageOffers          ..> UC_Auth : <<include>>
UC_ManageApplications    ..> UC_Auth : <<include>>
UC_ProposeInterview      ..> UC_Auth : <<include>>
UC_ManageFormations      ..> UC_Auth : <<include>>
UC_ManageEnrollRequests  ..> UC_Auth : <<include>>
UC_ManageEnrollments     ..> UC_Auth : <<include>>
UC_ManageUsers           ..> UC_Auth : <<include>>
UC_ManageNews            ..> UC_Auth : <<include>>
UC_ViewStats             ..> UC_Auth : <<include>>
UC_ManageSettings        ..> UC_Auth : <<include>>

@enduml
