@startuml diagramme_classe
skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName "Times New Roman"

' Basé exclusivement sur thebridgeflow-back/models/*.js.
' NOTE : le dossier thebridgeflow-back/models/ contient réellement 17 fichiers de schéma
' (et non 16) -- les 16 modèles "métier" listés ci-dessous + SiteSettings
' (document singleton de configuration, ajouté en fin de fichier).
' Aucune relation d'héritage / discriminator Mongoose entre modèles (vérifié :
' aucun appel à .discriminator() dans thebridgeflow-back/models/) -- toutes les relations
' sont des références ObjectId + ref, matérialisées ici par des associations.

' ══════════════════════════ MODELES PRINCIPAUX ══════════════════════════

class User {
  name : String
  email : String {unique}
  password : String {select:false}
  role : String <<enum: étudiant|admin>>
  gender : String <<enum: homme|femme>>
  avatarUrl : String
  googleId : String {unique, sparse}
  facebookId : String {unique, sparse}
  phone : String
  university : String
  specialty : String
  supervisorName : String
  isActive : Boolean
  isVerified : Boolean
  verifyCode : String {select:false}
  verifyCodeExpires : Date {select:false}
  resetPasswordToken : String {select:false}
  resetPasswordExpires : Date {select:false}
  bio : String
  cv : {fileName, fileUrl}
  education : {institution, degree, fieldOfStudy, startDate, endDate, current, grade, courses[]}
  experience : [ExperienceSchema]
  skills : [SkillSchema]
  languages : [LanguageSchema]
  socialLinks : {linkedin, github, portfolio}
  lastLoginAt : Date
  lastActiveAt : Date
  settings : {notifications, privacy, ai, internshipPreferences}
}

class Offer {
  title : String
  description : String
  companyName : String
  domain : String
  location : String
  duration : String
  type : String <<enum: stage|PFE|alternance|formation|vidéo>>
  skills : [String]
  salary : Number
  deadline : Date
  isActive : Boolean
  views : Number
  nbrInterns : String
}

class Application {
  status : String <<enum: en attente|acceptée|refusée|en cours>>
  coverLetter : String
  cvUrl : String
  note : String
}

class Interview {
  scheduledAt : Date
  mode : String <<enum: présentiel|en ligne>>
  location : String
  status : String <<enum: proposé|confirmé|annulé|terminé>>
  notes : String
}

class Document {
  title : String
  type : String <<enum: convention|attestation|rapport|cahier_de_charge|autre>>
  fileUrl : String
  status : String <<enum: en_attente|validé|refusé>>
  feedback : String
}
note bottom of Document
  Modèle défini mais non exploité :
  aucun controller ni route ne le référence
  (thebridgeflow-back/controllers/, thebridgeflow-back/routes/).
end note

class Notification {
  title : String
  message : String
  type : String <<enum: info|success|warning|error>>
  isRead : Boolean
  link : String
}

class Conversation {
  lastMessageAt : Date
  unreadCounts : Mixed <<{userId: count}>>
}

class Message {
  content : String <<maxlength 1000>>
  fileUrl : String
  fileName : String
  fileType : String
  fileSize : Number
  isRead : Boolean
}

class Enrollment {
  weekProgress : [WeekProgressSchema]
  overallStatus : String <<enum: not_started|in_progress|completed>>
}

class EnrollmentRequest {
  mode : String <<enum: Présentiel|En ligne>>
  message : String
  status : String <<enum: en_attente|acceptée|refusée>>
}

class News {
  title : String
  excerpt : String
  content : String
  category : String
  image : String <<lien Drive ou base64>>
  author : String
  publishedAt : Date
}

class LoginHistory {
  timestamp : Date
  method : String <<enum: email|google|facebook>>
  location : {country, city, timezone}
}
note bottom of LoginHistory
  Écrit à chaque connexion
  (auth.controller.js) mais jamais
  relu par aucun endpoint GET.
end note

class ViewLog {
  targetType : String <<enum: offer|formation>>
  targetId : ObjectId
  timestamp : Date
}
note bottom of ViewLog
  targetId n'a pas de "ref" Mongoose
  déclaré dans le schéma (pas de
  populate possible) -- le type réel
  pointé dépend de targetType.
  TODO: à vérifier si un usage
  additionnel existe hors thebridgeflow-back/.
  Modèle jamais importé ailleurs que
  sa propre définition (vérifié par
  recherche exhaustive) : orphelin.
end note

class PageVisit {
  path : String
  timestamp : Date
}

class VideoView {
  videoIdentifier : String
  videoLabel : String
  timestamp : Date
}

class Formation {
  title : String {unique}
  slug : String {unique}
  duration : String
  price : {onsite, online}
  level : String
  description : String
  weeks : [WeekSchema]
  supervision : [WeekSchema]
  mode : String <<enum: Présentiel|En ligne|Hybride>>
  certificate : Boolean
  image : String
  features : [String]
  technologies : [String]
  videos : [VideoSchema]
  reviews : [ReviewSchema]
  stats : {students, successRate, insertionRate, satisfaction}
  faq : [FaqSchema]
  trailerVideoUrl : String
  trailerThumbnail : String
  trailerProvider : String <<enum: cloudinary|google_drive>>
  trailerDriveUrl : String
  views : Number
}

' ══════════════════════ SOUS-SCHEMAS EMBARQUES (_id:false) ══════════════

class ExperienceSchema <<embedded>> {
  company, position, location : String
  startDate, endDate : Date
  current : Boolean
  description : String
  technologies : [String]
}
class SkillSchema <<embedded>> {
  name : String
  level : String <<enum: Débutant|Intermédiaire|Avancé|Expert>>
  category : String
}
class LanguageSchema <<embedded>> {
  name : String
  level : String <<enum: Débutant|Intermédiaire|Courant|Natif>>
}
class WeekProgressSchema <<embedded>> {
  weekNumber : Number
  status : String <<enum: not_started|in_progress|done>>
  completedAt : Date
}
class WeekSchema <<embedded>> {
  week : Number
  phase : String
  content : String
  videoUrl : String
  videoTitle : String
  thumbnail : String
  provider : String <<enum: cloudinary|google_drive>>
  driveUrl : String
  duree : String
  gratuit : Boolean
}
class VideoSchema <<embedded>> {
  url, title, description, thumbnail : String
  provider : String <<enum: cloudinary|google_drive>>
  driveUrl : String
}
class ReviewSchema <<embedded>> {
  name, avatar, comment : String
  rating : Number <<1..5>>
  date : Date
}
class FaqSchema <<embedded>> {
  question : String
  answer : String
}

User "1" *-- "0..*" ExperienceSchema
User "1" *-- "0..*" SkillSchema
User "1" *-- "0..*" LanguageSchema
Enrollment "1" *-- "0..*" WeekProgressSchema
Formation "1" *-- "0..*" WeekSchema : weeks / supervision
Formation "1" *-- "0..*" VideoSchema
Formation "1" *-- "0..*" ReviewSchema
Formation "1" *-- "0..*" FaqSchema

' ══════════════════════════ SITESETTINGS (singleton) ═════════════════════

class SiteSettings <<singleton>> {
  actionVideo : MediaSchema
  testimonialVideos : [TestimonialVideoSchema]
  communityAvatars : [CommunityAvatarSchema]
}
class MediaSchema <<embedded>> {
  url, driveUrl, thumbnail : String
  provider : String <<enum: cloudinary|google_drive>>
}
class TestimonialVideoSchema <<embedded>> {
  url, driveUrl, thumbnail : String
  provider : String <<enum: cloudinary|google_drive>>
  category : String <<enum: summer-camp|pfe|formation|unknown>>
}
class CommunityAvatarSchema <<embedded>> {
  name : String
  url : String
}
SiteSettings "1" *-- "1" MediaSchema : actionVideo
SiteSettings "1" *-- "0..*" TestimonialVideoSchema
SiteSettings "1" *-- "0..*" CommunityAvatarSchema

' ══════════════════════════ RELATIONS PAR REFERENCE (ObjectId + ref) ═════

User "1" -- "0..*" User : supervisorId >
User "1" -- "0..*" Offer : favorites >

Offer "1" -- "0..*" Application : offerId >
User "1" -- "0..*" Application : studentId >

Application "1" -- "0..1" Interview : applicationId >
User "1" -- "0..*" Interview : studentId >
User "1" -- "0..*" Interview : companyId (admin) >

User "1" -- "0..*" Document : studentId >

User "1" -- "0..*" Notification : userId >

User "0..*" -- "2" Conversation : participants >
Conversation "1" -- "0..1" Message : lastMessage >

Conversation "1" -- "0..*" Message : conversationId >
User "1" -- "0..*" Message : senderId >
User "1" -- "0..*" Message : receiverId >

User "1" -- "0..*" Enrollment : student >
Formation "1" -- "0..*" Enrollment : formation >

User "1" -- "0..*" EnrollmentRequest : student >
Formation "1" -- "0..*" EnrollmentRequest : formation >

User "1" -- "0..*" LoginHistory : userId >
User "0..1" -- "0..*" PageVisit : userId >
User "0..1" -- "0..*" VideoView : userId >
User "0..1" -- "0..*" ViewLog : userId >

@enduml
